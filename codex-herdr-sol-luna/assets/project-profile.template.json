{
  "schema_version": 1,
  "kind": "codex-herdr-sol-luna/project-profile",
  "project": {
    "name": "replace-me",
    "root": ".",
    "task_source": "AGENTS.md"
  },
  "roles": {
    "sol": {
      "owns": [
        "intake",
        "architecture",
        "design-sensitive implementation",
        "integration",
        "final decision"
      ],
      "sole_writer": true
    },
    "luna": {
      "enabled": true,
      "read_only": true,
      "allowed_modes": [
        "heartbeat-sentinel",
        "bounded-verifier",
        "interactive-operator"
      ]
    }
  },
  "paths": {
    "allowed": [
      "**"
    ],
    "forbidden": [
      ".git/**",
      ".env",
      ".env.*",
      "**/*.pem",
      "**/*.key"
    ]
  },
  "validation": {
    "cwd": ".",
    "command": "replace-with-one-focused-command",
    "timeout_seconds": 900
  },
  "evidence": {
    "directory": ".codex-herdr/evidence",
    "required": [
      "diff",
      "validation-result",
      "handoff"
    ]
  },
  "budgets": {
    "checkpoint_minutes": 20,
    "hard_stop_minutes": 45,
    "max_patch_batches": 1
  },
  "stop_conditions": [
    "out-of-scope write",
    "second writer or nested delegation",
    "hypothesis disproved or scope broadened",
    "checkpoint or hard-stop exceeded",
    "manual acceptance boundary reached"
  ],
  "manual_acceptance": {
    "required": false,
    "owner": "human",
    "criteria": []
  },
  "pane_policy": {
    "reuse_suitable_existing": true,
    "record_created": true,
    "close_recorded_only": true,
    "max_completed_workflow_panes": 0
  }
}
