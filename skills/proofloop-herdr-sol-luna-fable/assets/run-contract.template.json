{
  "schema_version": 3,
  "kind": "proofloop-herdr-sol-luna-fable/run-contract",
  "task": {
    "id": "replace-me",
    "source": "replace-with-project-task-source",
    "goal": "replace-with-one-concrete-outcome",
    "hypothesis": "replace-with-the-causal-or-design-hypothesis"
  },
  "project_profile": "path/to/project-profile.json",
  "phase": "build",
  "writer": "sol",
  "allowed_paths": [
    "replace/with/project-relative/path/**"
  ],
  "test_policy": {
    "baseline_record": ".proofloop/evidence/replace-with-run-id/test-baseline.json",
    "result_record": ".proofloop/evidence/replace-with-run-id/test-gate.json",
    "ephemeral_directory": ".proofloop/evidence/replace-with-run-id/probes",
    "admission_record": ".proofloop/evidence/replace-with-run-id/test-admission.json",
    "permanent": {"max_new_invariants": 0, "max_changed_test_files": 0, "max_added_test_lines": 0},
    "full_suite": {"allowed": false, "reason": null}
  },
  "luna_mode": null,
  "fable_stage": null,
  "validation": {
    "cwd": ".",
    "command": "replace-with-one-focused-command",
    "timeout_seconds": 900,
    "pass_criteria": [
      "command exits successfully",
      "semantic result is passing",
      "required artifacts exist"
    ]
  },
  "evidence": {
    "directory": ".proofloop/evidence/replace-with-run-id",
    "required": [
      "baseline",
      "diff",
      "validation-result",
      "test-gate",
      "handoff",
      "pane-ownership"
    ]
  },
  "budgets": {
    "checkpoint_minutes": 20,
    "hard_stop_minutes": 45,
    "max_patch_batches": 1
  },
  "stop_conditions": [
    "out-of-scope write",
    "second writer or nested delegation",
    "hypothesis disproved or scope broadened",
    "checkpoint or hard-stop exceeded",
    "manual acceptance boundary reached"
  ],
  "manual_acceptance": {
    "required": false,
    "owner": "human",
    "criteria": []
  },
  "cleanup": {
    "ownership_record": ".proofloop/evidence/replace-with-run-id/pane-ownership.json",
    "sentinel_process_record": ".proofloop/evidence/replace-with-run-id/sentinel-process.json",
    "sentinel_state_record": ".proofloop/evidence/replace-with-run-id/sentinel-state.json",
    "stop_recorded_sentinel_process": true,
    "close_recorded_workflow_panes": true,
    "leave_preexisting_panes_open": true,
    "retire_sentinel_state": true
  }
}
