{
  "schema_version": 3,
  "kind": "proofloop-herdr-sol-luna-fable-planr/project-profile",
  "project": {
    "name": "replace-me",
    "root": ".",
    "task_source": "AGENTS.md"
  },
  "roles": {
    "sol": {
      "owns": [
        "intake",
        "architecture",
        "design-sensitive implementation",
        "integration",
        "final decision"
      ],
      "sole_writer": true
    },
    "luna": {
      "enabled": true,
      "read_only": true,
      "allowed_modes": [
        "silent-sentinel",
        "bounded-verifier",
        "interactive-operator"
      ]
    },
    "fable": {
      "enabled": true,
      "max_turns_per_hypothesis": 1,
      "allowed_stages": [
        "pre-implementation",
        "final-review"
      ],
      "writer": false
    }
  },
  "sentinel_policy": {
    "default_mode": "off",
    "healthy_notifications": false,
    "deduplicate_events": true,
    "user_message_fallback": "critical-only",
    "max_runtime_minutes": 45,
    "exit_after_stop": true,
    "record_process": true
  },
  "paths": {
    "allowed": [
      "**"
    ],
    "forbidden": [
      ".git/**",
      ".env",
      ".env.*",
      "**/*.pem",
      "**/*.key"
    ]
  },
  "validation": {
    "cwd": ".",
    "command": "replace-with-one-focused-command",
    "full_suite_command": null,
    "timeout_seconds": 900
  },
  "testing": {
    "strategy": "distill",
    "tracked_test_globs": ["tests/**", "test/**", "spec/**", "__tests__/**", "**/tests/**", "**/test/**", "**/spec/**", "**/__tests__/**", "test_*.*", "*_test.*", "**/test_*.*", "**/*_test.*", "*.test.*", "*.spec.*", "**/*.test.*", "**/*.spec.*", "*test.java", "*tests.java", "**/*test.java", "**/*tests.java", "*test.kt", "*tests.kt", "**/*test.kt", "**/*tests.kt", "*test.cs", "*tests.cs", "**/*test.cs", "**/*tests.cs"],
    "build": {"permanent_test_edits": "deny", "full_suite": "deny"},
    "harden": {"permanent_test_edits": "admission-required", "max_new_invariants": 3, "max_changed_test_files": 3, "max_added_test_lines": 240, "full_suite": "ci-or-explicit"}
  },
  "evidence": {
    "directory": ".proofloop/evidence",
    "required": [
      "diff",
      "validation-result",
      "test-gate",
      "handoff"
    ]
  },
  "budgets": {
    "checkpoint_minutes": 20,
    "hard_stop_minutes": 45,
    "max_patch_batches": 1
  },
  "stop_conditions": [
    "out-of-scope write",
    "second writer or nested delegation",
    "hypothesis disproved or scope broadened",
    "checkpoint or hard-stop exceeded",
    "manual acceptance boundary reached"
  ],
  "manual_acceptance": {
    "required": false,
    "owner": "human",
    "criteria": []
  },
  "pane_policy": {
    "reuse_suitable_existing": true,
    "record_created": true,
    "close_recorded_only": true,
    "max_completed_workflow_panes": 0
  }
}
