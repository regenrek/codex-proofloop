{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmitOnError": true,
    "rootDir": "src",
    "outDir": "skills/proofloop/scripts",
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["src/**/*.mts"]
}
